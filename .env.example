# Copy to .env to override the defaults used by docker-compose.yml.
# All values are optional.

POSTGRES_USER=fitness
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fitness

# Host ports
APP_PORT=3005
DB_PORT=5455

# Time zone used for "today", streaks and weekly schedules
APP_TZ=Europe/Budapest

# Keep false on a plain-HTTP home network; true only behind HTTPS
COOKIE_SECURE=false

# Local development without Docker (npm run dev):
# DATABASE_URL=postgres://fitness:change-me@localhost:5455/fitness
